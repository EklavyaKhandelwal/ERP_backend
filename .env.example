DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
PORT=3001
NODE_ENV=development
COMPANY_TIME_ZONE=Asia/Kolkata

SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SEED_USER_NAME=HR
SEED_USER_ROLE=admin
SEED_USER_DEPARTMENT=Human Resources
SEED_USER_DESIGNATION=Human Resources

# Required to email employee setup/reset links and enable password recovery.
# Create a Resend API key and verify the sender address with Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=you@example.com
APP_BASE_URL=https://your-frontend.example.com